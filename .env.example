# GEMINI_API_KEY: Required for Gemini AI API calls (server-only).
GEMINI_API_KEY=

# Optional public site URL override for absolute links in production.
# NEXT_PUBLIC_SITE_URL=https://dialiqo.com

# Google Calendar Appointment Schedule (public booking page or embed iframe URL).
# Create in Google Calendar → Create appointment schedule → Share / embed.
NEXT_PUBLIC_GOOGLE_APPOINTMENT_URL=

# Inquiry email (Gmail SMTP — use a Google App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@dialiqo.com
SMTP_PASS=your-google-app-password
INQUIRY_TO_EMAIL=dhruvin.patel@dialiqo.com
INQUIRY_FROM_EMAIL=your-sender@dialiqo.com
INQUIRY_FROM_NAME=Dialiqo Website
